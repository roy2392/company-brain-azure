# ---------- Era (Wisteria Group) ----------
# Fill these with `npm run era:import` after copying the six `claude mcp add ...` commands
# from the Era console (Connect -> create token). The script reads the clipboard and never prints tokens.
ERA_ENV_ID=902aabb2dd6a17c60af7eb50b502e81b-roeyzalta-fintech-hyperscale-b2b
ERA_ZENDESK_TOKEN=
ERA_JIRA_CONFLUENCE_TOKEN=
ERA_GOOGLE_DRIVE_TOKEN=
ERA_GONG_TOKEN=
ERA_SALESFORCE_TOKEN=
ERA_SLACK_TOKEN=

# ---------- MongoDB Atlas ----------
# Local Atlas (docker compose `atlas` service). For Atlas cloud use the mongodb+srv:// string.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=wisteria_brain

# ---------- Embeddings ----------
# ollama (local, default) or voyage (set VOYAGE_API_KEY)
EMBEDDINGS_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5

# ---------- OpenMetadata ----------
OPENMETADATA_URL=http://localhost:8585
# Local quickstart admin (OpenMetadata defaults). Used only to mint a bot token on localhost.
OPENMETADATA_ADMIN_EMAIL=admin@open-metadata.org
OPENMETADATA_ADMIN_PASSWORD=admin
# Read-only bot token for OpenMetadata's MCP server — filled by `npm run om:mcp`
OPENMETADATA_MCP_TOKEN=
# Disable OM's Airflow client — we run ingestion jobs ourselves (read by docker compose).
PIPELINE_SERVICE_CLIENT_ENABLED=false

# ---------- Brain agent (Claude Agent SDK) ----------
# Use an Anthropic API key, or Microsoft Foundry (CLAUDE_CODE_USE_FOUNDRY=1 + ANTHROPIC_FOUNDRY_* vars).
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-sonnet-5-5

# ---------- Ingestion scope ----------
# How many customer accounts to pull deep context for (Slack/Gong/Zendesk/Jira per account).
BRAIN_FOCUS_ACCOUNTS=40
# Accounts always included in the deep pull (demo accounts first)
BRAIN_FOCUS_NAMES=Novaris Holdings,Bright Health,Ironwood Group,Cairn Group,Acacia Partners,Absolis

# agent-memory: shared memory for the Wisteria agents (docker compose service on :8000, database agent_memory)
AGENT_MEMORY_URL=http://localhost:8000
AGENT_MEMORY_TEAM=wisteria-revenue-team
# local LLM for memory enrichment (ollama pull qwen2.5:3b)
AGENT_MEMORY_LLM_MODEL=qwen2.5:3b
# only where files.pythonhosted.org is blocked: a PyPI mirror (wheels are hash-checked against uv.lock)
# AGENT_MEMORY_PIP_INDEX_URL=

# Microsoft Foundry agents (npm run foundry:agents) reach the brain through npm run gateway + a Dev Tunnel
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_ACCOUNT=
FOUNDRY_PROJECT=
FOUNDRY_AGENT_MODEL=gpt-5.2
FOUNDRY_GATEWAY_URL=https://<tunnel>-8790.<region>.devtunnels.ms
# created by npm run foundry:agents; per-agent gateway keys are HMACs of it
FOUNDRY_GATEWAY_SECRET=

# TLS for the VM's Azure DNS name (Let's Encrypt over HTTP-01 on port 80).
{$SITE_HOST} {
	encode zstd gzip

	# Foundry agents → gateway. No basic auth here: every request needs that agent's own key (checked by the gateway).
	@gateway path /agents/*
	handle @gateway {
		reverse_proxy brain:8790 {
			flush_interval -1
		}
	}

	# One-off downloads (e.g. the demo video): a random capability path, no login. Empty unless something is copied
	# into /opt/brain/data/share; the token lives in /opt/brain/env/share.token.
	handle_path /share/{$SHARE_TOKEN}/* {
		root * /srv/share
		file_server
	}

	# The web app and its API (/team) for people.
	handle {
		basic_auth {
			{$WEB_USER} {$WEB_PASSWORD_HASH}
		}
		reverse_proxy brain:8787
	}
}

# Portal browser (noVNC): a Chromium in Azure for portals your network blocks, and for portal demos.
# Only up while needed: docker compose -f docker-compose.azure.yml --profile portal up -d portal-browser
{$SITE_HOST}:8444 {
	basic_auth {
		{$BROWSER_USER} {$BROWSER_PASSWORD_HASH}
	}
	reverse_proxy portal-browser:6080
}

# OpenMetadata UI and API (OpenMetadata's own login; the admin password is set at bootstrap).
{$SITE_HOST}:8443 {
	encode zstd gzip
	reverse_proxy openmetadata-server:8585
}
